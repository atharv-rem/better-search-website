---
import Layout from '../layouts/Layout.astro';
import AppDemo from '../components/demo/AppDemo';
import GithubLogo from '../assets/icons/GithubLogo.svg';
import Logo from '../assets/icons/logo.svg';
import FileDownload from '../assets/icons/file-download-outline.svg';
import Changelog from '../components/changelog/Changelog';
import Comparison from '../components/comparison/Comparison.astro';
import FeatureFigure from '../components/features/FeatureFigure.astro';
import type { FigureName } from '../components/features/figures';

const repoUrl = 'https://github.com/atharv-rem/better-search';
const releaseUrl = `${repoUrl}/releases/latest`;

const features = [
	{ text: 'low memory\nusage ~10 - 17mb', figure: 'memory' },
	{ text: 'indexes once and\nnever touches the disk again', figure: 'indexOnce' },
	{ text: '2 million file\nrecords indexed in ~ 10s', figure: 'records' },
	{ text: 'private and local', figure: 'privateLocal' },
	{ text: '0% idle CPU use', figure: 'idleCpu' },
	{ text: 'searches in ~ 10 - 100ms', figure: 'search' },
	{ text: 'alt + s\ninstant opening', figure: 'altS' },
	{ text: 'snap any window,\nopened or unopened, using keyboard', figure: 'snapOpen' },
	{ text: 'instant web search\npowered by 4 providers', figure: 'instantSearch' },
	{ text: 'built-in calculator', figure: 'calculator' },
	{ text: 'find any document\nby what it says', figure: 'docContent' },
	{ text: 'find any image\nby what is in it', figure: 'imageContent' },
] as const satisfies readonly { text: string; figure?: FigureName }[];
---

<Layout>
	<main class="mx-auto w-full max-w-[1130px] px-5 pt-24 pb-32 sm:px-10 sm:pt-[200px]">
		<header class="flex flex-col items-start gap-4 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
			<h1 class="thin-display font-display text-3xl leading-[1.05] tracking-tight text-neutral-800 dark:text-neutral-100 sm:text-[2.6rem]">
				clean, super fast<br />
				search <span class="text-neutral-500 dark:text-neutral-400">for windows</span>
			</h1>

			<div class="flex shrink-0 items-center gap-2 sm:gap-3">
				<a
					href={repoUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					class="flex h-9 w-11 items-center justify-center rounded-lg sm:h-[46px] sm:w-[54px] sm:rounded-xl bg-black dark:bg-neutral-900 dark:ring-1 dark:ring-neutral-700 shadow-md shadow-black/10 sm:shadow-lg sm:shadow-black/25 transition-opacity hover:opacity-80"
				>
					<GithubLogo class="size-5 sm:size-7" aria-hidden="true" />
				</a>
				<button
					id="theme-toggle"
					type="button"
					aria-label="Toggle dark mode"
					class="flex h-9 w-11 cursor-pointer items-center justify-center rounded-lg bg-black text-white shadow-md shadow-black/10 transition-opacity hover:opacity-80 dark:bg-neutral-900 dark:ring-1 dark:ring-neutral-700 sm:h-[46px] sm:w-[54px] sm:rounded-xl sm:shadow-lg sm:shadow-black/25"
				>
					<svg class="size-5 dark:hidden sm:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
					<svg class="hidden size-5 dark:block sm:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
				</button>
				<a
					id="download-link"
					href={releaseUrl}
					data-repo="atharv-rem/better-search"
					class="flex h-9 items-center gap-2 rounded-lg bg-black dark:bg-neutral-900 dark:ring-1 dark:ring-neutral-700 px-4 font-display text-base sm:h-[46px] sm:gap-2.5 sm:rounded-xl sm:px-5 sm:text-xl text-white [--thin-bg:#000] dark:[--thin-bg:#171717] thin-display shadow-md shadow-black/10 sm:shadow-lg sm:shadow-black/25 transition-opacity hover:opacity-80"
				>
					<FileDownload class="size-5 shrink-0 sm:size-6" aria-hidden="true" />
					download
				</a>
			</div>
		</header>

		<!-- Diagonal box pattern background, from https://opensourceui.in/components/diagonal-box-pattern (MIT). -->
		<section
			class="relative isolate mt-5 h-[540px] overflow-hidden rounded-xl sm:rounded-3xl border border-neutral-200/70 bg-white dark:border-neutral-800 dark:bg-[#111] [background-image:repeating-linear-gradient(45deg,var(--box-line)_0,var(--box-line)_1px,transparent_0,transparent_50%)] [--box-line:#f5f5f5] dark:[--box-line:#1c1c1c] [background-size:12px_12px] sm:mt-8 sm:h-[640px]"
			aria-label="App demo"
		>
			<AppDemo client:only="react">
				<p slot="fallback" class="p-6 text-lg text-neutral-300 dark:text-neutral-600">demo of the app</p>
			</AppDemo>
		</section>

		<section class="mt-24 sm:mt-[150px]">
			<h2 class="thin-display font-display text-3xl leading-[1.05] tracking-tight text-neutral-800 dark:text-neutral-100 sm:text-[2.6rem]">
				30mb app <span class="text-neutral-500 dark:text-neutral-400">with<br />powerful features</span>
			</h2>

			<ul
				class="mt-9 grid grid-cols-1 border-t border-l border-neutral-200 dark:border-neutral-800 sm:grid-cols-[342fr_376fr_332fr]"
			>
				{
					features.map((feature) => (
						<li class="fg-host relative transition-colors hover:bg-neutral-100 dark:hover:bg-neutral-900 flex h-64 flex-col justify-end border-r border-b border-neutral-200 dark:border-neutral-800 p-5 sm:h-[287px]">
							{'figure' in feature && (
								<div class="absolute inset-x-5 top-5 bottom-[88px]">
									<FeatureFigure name={feature.figure} />
								</div>
							)}
							<p class="whitespace-pre-line text-lg font-semibold leading-[1.1] text-black dark:text-neutral-100">{feature.text}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-24 sm:mt-[150px]" aria-labelledby="comparison-heading">
			<h2 id="comparison-heading" class="thin-display font-display text-3xl leading-[1.05] tracking-tight text-neutral-800 dark:text-neutral-100 sm:text-[2.6rem]">
				better search <span class="text-neutral-500 dark:text-neutral-400">vs<br />windows search</span>
			</h2>
			<div class="mt-9">
				<Comparison />
			</div>
		</section>

		<section class="mt-24 sm:mt-[150px]" aria-labelledby="changelog-heading">
			<h2 id="changelog-heading" class="thin-display font-display text-3xl leading-[1.05] tracking-tight text-neutral-800 dark:text-neutral-100 sm:text-[2.6rem]">
				changelog <span class="text-neutral-500 dark:text-neutral-400">of every<br />release</span>
			</h2>
			<div class="mt-9">
				<Changelog client:visible repo="atharv-rem/better-search" />
			</div>
		</section>
	</main>

	<section class="mx-auto mb-16 grid w-full max-w-[1130px] gap-10 px-5 sm:mb-24 sm:grid-cols-2 sm:gap-6 sm:px-10">
		<div>
			<h2 class="flex items-center gap-2.5 font-pixel text-xl text-neutral-900 dark:text-neutral-100">
				<Logo class="size-6" aria-hidden="true" />
				Better Search
			</h2>
			<p class="mt-3 max-w-[460px] text-base leading-7 text-neutral-600 dark:text-neutral-400">
				Clean, super fast file search for Windows. A 30mb app that indexes 2 million files in about 10s and
				searches in 10 - 100ms, entirely private and local, with open source code on GitHub.
			</p>
		</div>
	</section>

	<div aria-hidden="true" class="pointer-events-none h-[11vw] select-none overflow-hidden text-center">
		<p class="whitespace-nowrap font-sans text-[17vw] font-medium leading-[0.85] tracking-tighter text-neutral-100 dark:text-neutral-900">better-search</p>
	</div>
</Layout>

<script>
	document.querySelector('#theme-toggle')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		} catch {}
	});
</script>

<script>
	// The button links to the latest release page; this points it straight at
	// the latest Windows installer instead. Asset names carry the version, so
	// the link can't be fixed ahead of time. If the lookup fails (offline, or
	// GitHub's rate limit), the release page link stays.
	//
	// The resolved URL is cached in localStorage so repeat visits point the
	// button at the installer immediately and skip the API call (it's
	// rate-limited to 60 requests/hour per IP). A fresh entry is used as is;
	// a stale one is applied right away and then refreshed in the background.
	const link = document.querySelector<HTMLAnchorElement>('#download-link');
	if (link?.dataset.repo) {
		const CACHE_KEY = 'installer-url';
		const MAX_AGE = 60 * 60 * 1000;

		let cached: { url: string; time: number } | null = null;
		try {
			const raw = JSON.parse(localStorage.getItem(CACHE_KEY) ?? 'null');
			if (typeof raw?.url === 'string' && typeof raw?.time === 'number') cached = raw;
		} catch {}

		if (cached) link.href = cached.url;

		if (!cached || Date.now() - cached.time > MAX_AGE) {
			fetch(`https://api.github.com/repos/${link.dataset.repo}/releases/latest`, {
				headers: { Accept: 'application/vnd.github+json' },
			})
				.then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
				.then((release: { assets: { name: string; browser_download_url: string }[] }) => {
					const installer = release.assets.find((a) => a.name.endsWith('-setup.exe'));
					if (!installer) return;
					link.href = installer.browser_download_url;
					try {
						localStorage.setItem(CACHE_KEY, JSON.stringify({ url: installer.browser_download_url, time: Date.now() }));
					} catch {}
				})
				.catch(() => {});
		}
	}
</script>
