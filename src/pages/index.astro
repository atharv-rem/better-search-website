---
import Layout from '../layouts/Layout.astro';
import AppDemo from '../components/demo/AppDemo';
import GithubLogo from '../assets/icons/GithubLogo.svg';
import FileDownload from '../assets/icons/file-download-outline.svg';

const repoUrl = 'https://github.com/atharv-rem/better-search';
const releaseUrl = `${repoUrl}/releases/latest`;

const features = [
	'low memory\nusage ~10 - 17mb',
	'indexes once and\nnever touches the disk again',
	'2 million file\nrecords indexed in ~ 10s',
	'private and local',
	'0% idle CPU use',
	'searches in ~ 10 - 100ms',
];
---

<Layout>
	<main class="mx-auto w-full max-w-[1130px] px-5 pt-24 pb-32 sm:px-10 sm:pt-[200px]">
		<header class="flex flex-col items-start gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
			<h1 class="thin-display font-display text-3xl leading-[1.05] tracking-tight text-neutral-800 sm:text-[2.6rem]">
				clean, super fast<br />
				search <span class="text-neutral-500">for windows</span>
			</h1>

			<div class="flex shrink-0 items-center gap-3">
				<a
					href={repoUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					class="flex h-9 w-11 items-center justify-center rounded-lg sm:h-[46px] sm:w-[54px] sm:rounded-xl bg-black shadow-md shadow-black/10 sm:shadow-lg sm:shadow-black/25 transition-opacity hover:opacity-80"
				>
					<GithubLogo class="size-5 sm:size-7" aria-hidden="true" />
				</a>
				<a
					id="download-link"
					href={releaseUrl}
					data-repo="atharv-rem/better-search"
					class="flex h-9 items-center gap-2 rounded-lg bg-black px-4 font-display text-base sm:h-[46px] sm:gap-2.5 sm:rounded-xl sm:px-5 sm:text-xl text-white [--thin-bg:#000] thin-display shadow-md shadow-black/10 sm:shadow-lg sm:shadow-black/25 transition-opacity hover:opacity-80"
				>
					<FileDownload class="size-5 shrink-0 sm:size-6" aria-hidden="true" />
					download
				</a>
			</div>
		</header>

		<!-- Diagonal box pattern background, from https://opensourceui.in/components/diagonal-box-pattern (MIT). -->
		<section
			class="relative isolate mt-8 h-[540px] overflow-hidden rounded-3xl border border-neutral-200/70 bg-white [background-image:repeating-linear-gradient(45deg,#f5f5f5_0,#f5f5f5_1px,transparent_0,transparent_50%)] [background-size:12px_12px] sm:h-[640px]"
			aria-label="App demo"
		>
			<AppDemo client:only="react">
				<p slot="fallback" class="p-6 text-lg text-neutral-300">demo of the app</p>
			</AppDemo>
		</section>

		<section class="mt-24 sm:mt-[150px]">
			<h2 class="thin-display font-display text-3xl leading-[1.05] tracking-tight text-neutral-800 sm:text-[2.6rem]">
				30mb app <span class="text-neutral-500">with<br />powerful features</span>
			</h2>

			<ul
				class="mt-9 grid grid-cols-1 border-t border-l border-neutral-200 sm:grid-cols-[342fr_376fr_332fr]"
			>
				{
					features.map((text) => (
						<li class="flex h-40 flex-col justify-end border-r border-b border-neutral-200 p-5 sm:h-[287px]">
							<!-- feature icon: add later -->
							<p class="whitespace-pre-line text-lg font-semibold leading-[1.1] text-black">{text}</p>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Layout>

<script>
	// The button links to the latest release page; this points it straight at
	// the latest Windows installer instead. Asset names carry the version, so
	// the link can't be fixed ahead of time. If the lookup fails (offline, or
	// GitHub's rate limit), the release page link stays.
	const link = document.querySelector<HTMLAnchorElement>('#download-link');
	if (link?.dataset.repo) {
		fetch(`https://api.github.com/repos/${link.dataset.repo}/releases/latest`, {
			headers: { Accept: 'application/vnd.github+json' },
		})
			.then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
			.then((release: { assets: { name: string; browser_download_url: string }[] }) => {
				const installer = release.assets.find((a) => a.name.endsWith('-setup.exe'));
				if (installer) link.href = installer.browser_download_url;
			})
			.catch(() => {});
	}
</script>
