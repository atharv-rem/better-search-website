# Cache headers for Netlify and Cloudflare Pages (vercel.json mirrors these for Vercel).
# Rules are kept non-overlapping on purpose: some hosts join the values when several rules match.
# HTML, robots.txt and sitemap.xml keep the host default (always revalidate), so deploys show up at once.

# Astro fingerprints everything in /_astro, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static assets: cache for a day, then serve stale for up to a week while refreshing.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logo.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
